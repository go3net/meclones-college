# ============================================================
# Meclones College Lekki — environment variables
# Copy to .env.local for local dev, set on Railway for prod.
# ============================================================

# --- Database (PostgreSQL on Railway) ---
DATABASE_URL="postgresql://user:password@host:5432/meclones"

# --- NextAuth ---
# `openssl rand -base64 32` to generate
AUTH_SECRET="replace-me"
# In dev: http://localhost:3000  In prod: https://meclonescollege.com
NEXTAUTH_URL="http://localhost:3000"

# --- Resend (transactional email) ---
RESEND_API_KEY=""
RESEND_FROM="Meclones College <noreply@meclonescollege.com>"
ADMISSIONS_NOTIFY_EMAIL="admissions@meclonescollege.com"
CONTACT_NOTIFY_EMAIL="info@meclonescollege.com"

# --- Cloudinary (media uploads) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# --- Paystack (school fees payments) ---
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# --- WhatsApp Cloud API + n8n (Part 3) ---
# Shared secret n8n must send as `Authorization: Bearer <value>` when calling
# /api/whatsapp/*. Generate with `openssl rand -hex 32`.
WHATSAPP_WEBHOOK_SECRET=""
# Meta WhatsApp Cloud API credentials (used if you handle Meta webhooks
# directly instead of routing through n8n; not required when n8n is the relay).
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
# Optional: n8n webhook URL the app calls to push notifications back out.
N8N_WEBHOOK_URL=""

# --- App ---
NEXT_PUBLIC_SITE_URL="https://meclonescollege.com"

# --- SchoolBot platform (multi-tenant) ---
# Root domain of the platform. `{slug}.<root>` resolves to that school;
# the bare root serves the SchoolBot sales site.
PLATFORM_ROOT_DOMAIN="schoolbot.com.ng"
# School served on hosts that match nothing else (the Railway URL, localhost).
# Also the slug given to the first School row created by the boot backfill.
DEFAULT_SCHOOL_SLUG="meclones"
DEFAULT_SCHOOL_DOMAIN="meclonescollege.com"
# 32 random bytes, base64 (`openssl rand -base64 32`). Encrypts per-school
# WhatsApp / Paystack secrets at rest.
APP_ENCRYPTION_KEY=""
# Platform operator account, created on boot if the email doesn't exist yet.
PLATFORM_ADMIN_EMAIL=""
PLATFORM_ADMIN_PASSWORD=""
# warn  = log any query that runs without a resolvable school, then proceed
# strict = reject such queries (flip once production logs are clean)
TENANT_ENFORCEMENT="warn"
# SchoolBot's own contact details, shown on the sales site (bare platform host).
PLATFORM_PHONE="0806 024 6634"
PLATFORM_PHONE_INTL="+2348060246634"
PLATFORM_EMAIL="hello@schoolbot.com.ng"
PLATFORM_WHATSAPP="2348060246634"
