// Meclones College Lekki — Prisma schema
// Covers Part 1 (admissions, contact, gallery, blog), Part 2 (portal: users,
// students, teachers, parents, classes, subjects, sessions, terms, results,
// attendance, fees, announcements), and Part 3 (WhatsApp automation).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH / USERS
// ============================================================

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         Role     @default(PARENT)
  isActive     Boolean  @default(true)
  emailVerified DateTime?
  image        String?

  student      Student?
  teacher      Teacher?
  parent       Parent?

  whatsappSessions WhatsAppSession[]
  announcements    Announcement[]   @relation("AnnouncementAuthor")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([role])
}

// ============================================================
// PEOPLE
// ============================================================

enum Gender {
  MALE
  FEMALE
}

model Student {
  id              String   @id @default(cuid())
  admissionNumber String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String   @unique
  classRef        Class?   @relation(fields: [classId], references: [id])
  classId         String?
  photoUrl        String?
  dob             DateTime?
  gender          Gender?
  address         String?

  results        Result[]
  attendance     Attendance[]
  fees           Fee[]
  parentLinks    ParentStudent[]
  whatsappSessions WhatsAppSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classId])
}

model Parent {
  id      String   @id @default(cuid())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String   @unique
  whatsappOptIn Boolean @default(false)

  children ParentStudent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Many-to-many: a parent can have multiple students; a student can have 1–2 parents
model ParentStudent {
  id        String   @id @default(cuid())
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  parentId  String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  relation  String?  // e.g. "Father", "Mother", "Guardian"

  createdAt DateTime @default(now())

  @@unique([parentId, studentId])
  @@index([studentId])
}

model Teacher {
  id      String   @id @default(cuid())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String   @unique
  bio     String?

  classTeacherOf Class[]    @relation("ClassTeacher")
  subjects       SubjectTeacher[]
  classes        ClassTeacher[]
  results        Result[]   @relation("ResultAuthor")
  attendance     Attendance[] @relation("AttendanceMarker")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// CLASSES, SUBJECTS, SESSIONS
// ============================================================

enum Level {
  JSS
  SSS
}

model Class {
  id        String  @id @default(cuid())
  name      String  // e.g. "JSS 1"
  arm       String  // e.g. "A", "B"
  level     Level
  classTeacher   Teacher? @relation("ClassTeacher", fields: [classTeacherId], references: [id])
  classTeacherId String?

  students    Student[]
  subjects    ClassSubject[]
  teachers    ClassTeacher[]
  attendance  Attendance[]
  announcements Announcement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, arm])
}

model Subject {
  id    String  @id @default(cuid())
  name  String
  code  String  @unique

  classes  ClassSubject[]
  teachers SubjectTeacher[]
  results  Result[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Join: subjects offered in a class
model ClassSubject {
  id        String  @id @default(cuid())
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId   String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId String

  @@unique([classId, subjectId])
}

// Join: teachers assigned to subjects
model SubjectTeacher {
  id        String  @id @default(cuid())
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId String

  @@unique([teacherId, subjectId])
}

// Join: teachers assigned to classes (subject-teacher mapping for a class)
model ClassTeacher {
  id        String  @id @default(cuid())
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId   String

  @@unique([teacherId, classId])
}

model AcademicSession {
  id        String   @id @default(cuid())
  name      String   @unique // e.g. "2024/2025"
  isActive  Boolean  @default(false)
  startDate DateTime?
  endDate   DateTime?

  terms    Term[]
  results  Result[]
  fees     Fee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TermName {
  FIRST
  SECOND
  THIRD
}

model Term {
  id        String   @id @default(cuid())
  name      TermName
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  isActive  Boolean  @default(false)
  startDate DateTime?
  endDate   DateTime?

  results    Result[]
  attendance Attendance[]
  fees       Fee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, sessionId])
}

// ============================================================
// RESULTS, ATTENDANCE, FEES
// ============================================================

model Result {
  id        String   @id @default(cuid())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId String
  term      Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  termId    String
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  enteredBy Teacher? @relation("ResultAuthor", fields: [enteredById], references: [id])
  enteredById String?

  ca1   Int @default(0) // /20
  ca2   Int @default(0) // /20
  exam  Int @default(0) // /60
  total Int @default(0) // /100
  grade String?         // A1, B2, B3, C4, C5, C6, D7, E8, F9
  position Int?
  isPublished Boolean @default(false)
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, subjectId, termId, sessionId])
  @@index([termId, sessionId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

model Attendance {
  id        String           @id @default(cuid())
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  class     Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId   String
  term      Term?            @relation(fields: [termId], references: [id])
  termId    String?
  date      DateTime         @db.Date
  status    AttendanceStatus
  markedBy  Teacher?         @relation("AttendanceMarker", fields: [markedById], references: [id])
  markedById String?

  createdAt DateTime @default(now())

  @@unique([studentId, date])
  @@index([classId, date])
}

enum FeeStatus {
  UNPAID
  PARTIAL
  PAID
}

model Fee {
  id        String   @id @default(cuid())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  term      Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  termId    String
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  feeType   String   // e.g. "Tuition", "Development Levy"
  amount    Decimal  @db.Decimal(12, 2)
  amountPaid Decimal @db.Decimal(12, 2) @default(0)
  balance   Decimal  @db.Decimal(12, 2)
  paystackRef String?
  status    FeeStatus @default(UNPAID)
  dueDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, termId])
}

// ============================================================
// ANNOUNCEMENTS
// ============================================================

enum AnnouncementAudience {
  ALL
  CLASS
  PARENTS
  STAFF
  STUDENTS
}

model Announcement {
  id             String   @id @default(cuid())
  title          String
  body           String   @db.Text
  audience       AnnouncementAudience @default(ALL)
  class          Class?   @relation(fields: [classId], references: [id])
  classId        String?
  author         User?    @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  authorId       String?
  publishedAt    DateTime?
  sendWhatsApp   Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([audience])
}

// ============================================================
// ADMISSIONS (public-site form)
// ============================================================

enum AdmissionStatus {
  SUBMITTED
  UNDER_REVIEW
  EXAM_SCHEDULED
  ADMITTED
  REJECTED
}

model Admission {
  id              String   @id @default(cuid())
  applicantName   String
  dob             DateTime?
  gender          Gender?
  classApplyingFor String  // "JSS 1", "SS 2", etc.
  previousSchool  String?
  parentName      String
  parentPhone     String
  parentEmail     String
  parentOccupation String?
  homeAddress     String?
  documents       Json?    // [{ url, label }]
  notes           String?  @db.Text
  status          AdmissionStatus @default(SUBMITTED)
  reference       String   @unique
  examDate        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ============================================================
// CONTACT FORM (public-site)
// ============================================================

model ContactMessage {
  id       String   @id @default(cuid())
  name     String
  email    String
  phone    String?
  subject  String?
  role     String?  // "Prospective parent", "Alumni", etc.
  message  String   @db.Text
  handledAt DateTime?

  createdAt DateTime @default(now())
}

// ============================================================
// WHATSAPP AUTOMATION
// ============================================================

model WhatsAppSession {
  id              String   @id @default(cuid())
  phoneNumber     String
  admissionNumber String?
  student         Student? @relation(fields: [studentId], references: [id])
  studentId       String?
  user            User?    @relation(fields: [userId], references: [id])
  userId          String?
  lastMenu        String?
  lastActivity    DateTime @default(now())
  isEscalated     Boolean  @default(false)
  escalatedAt     DateTime?
  resolvedAt      DateTime?

  messages WhatsAppMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phoneNumber])
}

enum MessageDirection {
  IN
  OUT
}

model WhatsAppMessage {
  id        String   @id @default(cuid())
  session   WhatsAppSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  direction MessageDirection
  content   String   @db.Text
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
}

// ============================================================
// MEDIA: GALLERY + BLOG
// ============================================================

model GalleryImage {
  id           String   @id @default(cuid())
  url          String
  cloudinaryId String?
  caption      String?
  category     String?  // "Sports", "Events", "Academics", "Facilities"
  uploadedAt   DateTime @default(now())

  @@index([category])
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  body        String   @db.Text
  excerpt     String?
  coverImage  String?
  isPublished Boolean  @default(false)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, publishedAt])
}
