// Meclones College Lekki — Prisma schema
// Covers Part 1 (admissions, contact, gallery, blog), Part 2 (portal: users,
// students, teachers, parents, classes, subjects, sessions, terms, results,
// attendance, fees, announcements), and Part 3 (WhatsApp automation).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH / USERS
// ============================================================

enum Role {
  SUPER_ADMIN
  DIRECTOR
  ADMIN
  ACCOUNTANT
  TEACHER
  STUDENT
  PARENT
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         Role     @default(PARENT)
  isActive     Boolean  @default(true)
  emailVerified DateTime?
  image        String?

  student      Student?
  teacher      Teacher?
  parent       Parent?

  /// Granular per-admin permissions. Super-admin always has all; for ADMIN
  /// role users, super-admin can flip these on/off.
  permissions  AdminPermissions?

  whatsappSessions WhatsAppSession[]
  announcements    Announcement[]   @relation("AnnouncementAuthor")
  complaintsFiled  Complaint[]      @relation("ComplaintAuthor")
  complaintsHandled Complaint[]     @relation("ComplaintHandler")
  bookRequests     BookRequest[]    @relation("BookRequester")
  bookApprovals    BookRequest[]    @relation("BookApprover")
  awardsIssued     Award[]          @relation("AwardedBy")
  notifications    Notification[]   @relation("UserNotifications")
  auditLogs        AuditLog[]       @relation("AuditActor")
  studentNotes     StudentNote[]    @relation("StudentNoteAuthor")
  messages         Message[]        @relation("MessageAuthor")

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([role])
}

/// In-portal notifications fanned out when something the user cares about
/// happens (announcement, result publish, fee charge, complaint reply, etc.).
/// Powers the bell icon in the portal shell.
enum NotificationType {
  ANNOUNCEMENT
  RESULT_PUBLISHED
  FEE_CHARGED
  PAYMENT_RECEIVED
  COMPLAINT_REPLIED
  ADMISSION_UPDATE
  WHATSAPP_INCOMING
  GENERIC
}

model Notification {
  id        String  @id @default(cuid())
  user      User    @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      NotificationType @default(GENERIC)
  title     String
  body      String  @db.Text
  /// Optional deep link to the related entity (e.g. /portal/parent/results).
  href      String?
  isRead    Boolean @default(false)
  readAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
}

/// Immutable trail of sensitive actions for accountability/compliance.
/// Never updated after insert — only appended and read.
model AuditLog {
  id          String   @id @default(cuid())
  /// User who performed the action. Null only if action is system-driven.
  actor       User?    @relation("AuditActor", fields: [actorId], references: [id])
  actorId     String?
  /// Short verb-style action identifier, e.g. "user.password_reset",
  /// "result.publish", "fee.charge", "session.rotate".
  action      String
  /// Optional target reference — e.g. targetType="User", targetId="cuid…".
  targetType  String?
  targetId    String?
  /// Free-form metadata (request body, IP, before/after snapshots, etc.).
  metadata    Json?
  /// Snapshot of actor info in case the actor user gets deleted.
  actorName   String?
  actorEmail  String?
  actorRole   String?

  createdAt DateTime @default(now())

  @@index([action, createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}

/// One-time tokens for password reset. Tokens are randomly generated,
/// SHA-256 hashed for storage, and expire 1 hour from creation.
model PasswordResetToken {
  id        String   @id @default(cuid())
  /// SHA-256 of the raw token. The raw value never lives in the DB.
  tokenHash String   @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([email])
}

/// Per-admin permission flags. Defaults are permissive (true) for now —
/// super-admin can disable specific capabilities for individual admins via
/// `/portal/director/permissions`.
model AdminPermissions {
  id              String @id @default(cuid())
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String @unique

  canManageStudents     Boolean @default(true)
  canManageTeachers     Boolean @default(true)
  canManageParents      Boolean @default(true)
  canManageClasses      Boolean @default(true)
  canManageFees         Boolean @default(true)
  canManageResults      Boolean @default(true)
  canPublishAnnouncements Boolean @default(true)
  canHandleAdmissions   Boolean @default(true)
  canHandleComplaints   Boolean @default(true)
  canManageLibrary      Boolean @default(true)
  canRotateSession      Boolean @default(false)   // school-wide; default off

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ============================================================
// PEOPLE
// ============================================================

enum Gender {
  MALE
  FEMALE
}

model Student {
  id              String   @id @default(cuid())
  admissionNumber String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String   @unique
  classRef        Class?   @relation(fields: [classId], references: [id])
  classId         String?
  photoUrl        String?
  dob             DateTime?
  gender          Gender?
  address         String?
  /// Set when the student graduates (passes SS 3 / leaves the school).
  /// Graduated students hide from active class lists but their full
  /// history (results, attendance, fees, payments) is retained.
  graduatedAt     DateTime?

  results        Result[]
  attendance     Attendance[]
  fees           Fee[]
  awards         Award[]
  notes          StudentNote[]
  parentLinks    ParentStudent[]
  whatsappSessions WhatsAppSession[]
  messageThreads MessageThread[] @relation("ThreadStudent")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classId])
}

enum StudentNoteCategory {
  ACADEMIC
  BEHAVIOUR
  ATTENDANCE
  HEALTH
  COMMENDATION
  OTHER
}

enum StudentNoteVisibility {
  /// Visible to teachers + admins + director + super-admin.
  STAFF_ONLY
  /// Sensitive — only admin / director / super-admin can see.
  ADMIN_ONLY
  /// Shared with the linked parent's portal too (good for commendations).
  PARENT_VISIBLE
}

/// Free-form observation from a teacher or admin about a student. Used to
/// capture context that doesn't fit anywhere else — behavioural notes,
/// commendations, health alerts, etc. Visible to other staff (and
/// optionally parents) on the student profile.
model StudentNote {
  id          String  @id @default(cuid())
  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId   String
  author      User?   @relation("StudentNoteAuthor", fields: [authorId], references: [id])
  authorId    String?
  /// Snapshot for resilience if the author user is deleted later.
  authorName  String
  authorRole  String?
  category    StudentNoteCategory   @default(OTHER)
  visibility  StudentNoteVisibility @default(STAFF_ONLY)
  body        String  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, createdAt])
  @@index([visibility])
}

model Parent {
  id      String   @id @default(cuid())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String   @unique
  whatsappOptIn Boolean @default(false)

  children       ParentStudent[]
  messageThreads MessageThread[] @relation("ThreadParent")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Many-to-many: a parent can have multiple students; a student can have 1–2 parents
model ParentStudent {
  id        String   @id @default(cuid())
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  parentId  String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  relation  String?  // e.g. "Father", "Mother", "Guardian"

  createdAt DateTime @default(now())

  @@unique([parentId, studentId])
  @@index([studentId])
}

model Teacher {
  id      String   @id @default(cuid())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String   @unique
  bio     String?

  classTeacherOf Class[]    @relation("ClassTeacher")
  subjects       SubjectTeacher[]
  classes        ClassTeacher[]
  results        Result[]   @relation("ResultAuthor")
  attendance     Attendance[] @relation("AttendanceMarker")
  timetableEntries TimetableEntry[] @relation("TimetableTeacher")
  messageThreads MessageThread[] @relation("ThreadTeacher")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// CLASSES, SUBJECTS, SESSIONS
// ============================================================

enum Level {
  JSS
  SSS
}

model Class {
  id        String  @id @default(cuid())
  name      String  // e.g. "JSS 1"
  arm       String  // e.g. "A", "B"
  level     Level
  classTeacher   Teacher? @relation("ClassTeacher", fields: [classTeacherId], references: [id])
  classTeacherId String?

  students        Student[]
  subjects        ClassSubject[]
  teachers        ClassTeacher[]
  attendance      Attendance[]
  announcements   Announcement[]
  timetableEntries TimetableEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, arm])
}

/// A 2-way conversation between one Parent and one Teacher, optionally
/// scoped to a Student (so e.g. a teacher can have separate threads about
/// two siblings with the same parent).
model MessageThread {
  id        String   @id @default(cuid())
  parent    Parent   @relation("ThreadParent", fields: [parentId], references: [id], onDelete: Cascade)
  parentId  String
  teacher   Teacher  @relation("ThreadTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId String
  student   Student? @relation("ThreadStudent", fields: [studentId], references: [id])
  studentId String?
  subject   String
  /// Denormalised for cheap inbox sorting / "latest" preview.
  lastMessageAt DateTime @default(now())
  /// Per-side unread counters; incremented by sendMessage based on author.
  parentUnread  Int @default(0)
  teacherUnread Int @default(0)

  messages  Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId, lastMessageAt])
  @@index([teacherId, lastMessageAt])
}

model Message {
  id        String @id @default(cuid())
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId  String
  author    User   @relation("MessageAuthor", fields: [authorId], references: [id])
  authorId  String
  body      String @db.Text

  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

/// Weekly class timetable. One row = one period on one day for one class.
/// `subjectId` null means a non-academic period (break, assembly, etc.) —
/// use `note` to label it.
model TimetableEntry {
  id        String   @id @default(cuid())
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId   String
  subject   Subject? @relation(fields: [subjectId], references: [id])
  subjectId String?
  teacher   Teacher? @relation("TimetableTeacher", fields: [teacherId], references: [id])
  teacherId String?

  day       DayOfWeek
  period    Int        // 1..N
  startTime String?    // "08:00" — display only
  endTime   String?    // "08:40"
  room      String?
  note      String?    // e.g. "Break", "Assembly"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, day, period])
  @@index([teacherId])
  @@index([subjectId])
}

model Subject {
  id    String  @id @default(cuid())
  name  String
  code  String  @unique

  classes  ClassSubject[]
  teachers SubjectTeacher[]
  results  Result[]
  timetableEntries TimetableEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Join: subjects offered in a class
model ClassSubject {
  id        String  @id @default(cuid())
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId   String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId String

  @@unique([classId, subjectId])
}

// Join: teachers assigned to subjects
model SubjectTeacher {
  id        String  @id @default(cuid())
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId String

  @@unique([teacherId, subjectId])
}

// Join: teachers assigned to classes (subject-teacher mapping for a class)
model ClassTeacher {
  id        String  @id @default(cuid())
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId   String

  @@unique([teacherId, classId])
}

model AcademicSession {
  id        String   @id @default(cuid())
  name      String   @unique // e.g. "2024/2025"
  isActive  Boolean  @default(false)
  startDate DateTime?
  endDate   DateTime?

  terms    Term[]
  results  Result[]
  fees     Fee[]
  awards   Award[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TermName {
  FIRST
  SECOND
  THIRD
}

model Term {
  id        String   @id @default(cuid())
  name      TermName
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  isActive  Boolean  @default(false)
  startDate DateTime?
  endDate   DateTime?

  results    Result[]
  attendance Attendance[]
  fees       Fee[]
  awards     Award[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, sessionId])
}

// ============================================================
// RESULTS, ATTENDANCE, FEES
// ============================================================

model Result {
  id        String   @id @default(cuid())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId String
  term      Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  termId    String
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  enteredBy Teacher? @relation("ResultAuthor", fields: [enteredById], references: [id])
  enteredById String?

  ca1   Int @default(0) // /20
  ca2   Int @default(0) // /20
  exam  Int @default(0) // /60
  total Int @default(0) // /100
  grade String?         // A1, B2, B3, C4, C5, C6, D7, E8, F9
  position Int?
  isPublished Boolean @default(false)
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, subjectId, termId, sessionId])
  @@index([termId, sessionId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

model Attendance {
  id        String           @id @default(cuid())
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  class     Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId   String
  term      Term?            @relation(fields: [termId], references: [id])
  termId    String?
  date      DateTime         @db.Date
  status    AttendanceStatus
  markedBy  Teacher?         @relation("AttendanceMarker", fields: [markedById], references: [id])
  markedById String?

  createdAt DateTime @default(now())

  @@unique([studentId, date])
  @@index([classId, date])
}

enum FeeStatus {
  UNPAID
  PARTIAL
  PAID
}

/// A reusable fee structure (set of line items) the admin defines once and
/// applies to one or more classes at the start of a term. Charging the
/// structure creates Fee rows for every student in the targeted class.
model FeeStructure {
  id    String @id @default(cuid())
  name  String  // e.g. "JSS Term 1 2026/2027"
  level Level?  // optional scope hint
  /// JSON array of {feeType, amount} line items.
  items Json
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Fee {
  id        String   @id @default(cuid())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  term      Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  termId    String
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  feeType   String   // e.g. "Tuition", "Development Levy"
  amount    Decimal  @db.Decimal(12, 2)
  amountPaid Decimal @db.Decimal(12, 2) @default(0)
  balance   Decimal  @db.Decimal(12, 2)
  paystackRef String?
  status    FeeStatus @default(UNPAID)
  dueDate   DateTime?

  payments  Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, termId])
}

/// One row per payment attempt against a Fee — Paystack success/failure
/// and manual cash/transfer entries all live here. Gives the school a full
/// audit trail and powers receipt printing.
enum PaymentMethod {
  PAYSTACK
  CASH
  TRANSFER
  CHEQUE
  POS
  OTHER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Payment {
  id          String   @id @default(cuid())
  fee         Fee      @relation(fields: [feeId], references: [id], onDelete: Cascade)
  feeId       String
  amount      Decimal  @db.Decimal(12, 2)
  reference   String   @unique
  method      PaymentMethod @default(PAYSTACK)
  status      PaymentStatus @default(PENDING)
  channel     String?  // card / bank / ussd / etc — from Paystack response
  paidAt      DateTime?
  /// Raw Paystack payload, kept for forensic checks later.
  rawPayload  Json?
  /// Admin/Accountant who recorded a manual payment. Null for self-service.
  createdById String?
  notes       String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([feeId])
  @@index([status, createdAt])
}

// ============================================================
// ANNOUNCEMENTS
// ============================================================

enum AnnouncementAudience {
  ALL
  CLASS
  PARENTS
  STAFF
  STUDENTS
}

model Announcement {
  id             String   @id @default(cuid())
  title          String
  body           String   @db.Text
  audience       AnnouncementAudience @default(ALL)
  class          Class?   @relation(fields: [classId], references: [id])
  classId        String?
  author         User?    @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  authorId       String?
  publishedAt    DateTime?
  sendWhatsApp   Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([audience])
}

// ============================================================
// ADMISSIONS (public-site form)
// ============================================================

enum AdmissionStatus {
  SUBMITTED
  UNDER_REVIEW
  EXAM_SCHEDULED
  ADMITTED
  REJECTED
}

model Admission {
  id              String   @id @default(cuid())
  applicantName   String
  dob             DateTime?
  gender          Gender?
  classApplyingFor String  // "JSS 1", "SS 2", etc.
  previousSchool  String?
  parentName      String
  parentPhone     String
  parentEmail     String
  parentOccupation String?
  homeAddress     String?
  documents       Json?    // [{ url, label }]
  notes           String?  @db.Text
  status          AdmissionStatus @default(SUBMITTED)
  reference       String   @unique
  examDate        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ============================================================
// CONTACT FORM (public-site)
// ============================================================

model ContactMessage {
  id       String   @id @default(cuid())
  name     String
  email    String
  phone    String?
  subject  String?
  role     String?  // "Prospective parent", "Alumni", etc.
  message  String   @db.Text
  handledAt DateTime?

  createdAt DateTime @default(now())
}

// ============================================================
// WHATSAPP AUTOMATION
// ============================================================

model WhatsAppSession {
  id              String   @id @default(cuid())
  phoneNumber     String
  admissionNumber String?
  student         Student? @relation(fields: [studentId], references: [id])
  studentId       String?
  user            User?    @relation(fields: [userId], references: [id])
  userId          String?
  lastMenu        String?
  lastActivity    DateTime @default(now())
  isEscalated     Boolean  @default(false)
  escalatedAt     DateTime?
  resolvedAt      DateTime?

  messages WhatsAppMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phoneNumber])
}

enum MessageDirection {
  IN
  OUT
}

model WhatsAppMessage {
  id        String   @id @default(cuid())
  session   WhatsAppSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  direction MessageDirection
  content   String   @db.Text
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
}

// ============================================================
// MEDIA: GALLERY + BLOG
// ============================================================

model GalleryImage {
  id           String   @id @default(cuid())
  url          String
  cloudinaryId String?
  caption      String?
  category     String?  // "Sports", "Events", "Academics", "Facilities"
  uploadedAt   DateTime @default(now())

  @@index([category])
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  body        String   @db.Text
  excerpt     String?
  coverImage  String?
  isPublished Boolean  @default(false)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, publishedAt])
}

// ============================================================
// COMPLAINTS / FEEDBACK
// ============================================================

enum ComplaintCategory {
  ACADEMIC
  FEES
  STAFF
  FACILITY
  TRANSPORT
  GENERAL
  OTHER
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Complaint {
  id          String   @id @default(cuid())
  subject     String
  body        String   @db.Text
  category    ComplaintCategory @default(GENERAL)
  status      ComplaintStatus   @default(OPEN)

  author      User?    @relation("ComplaintAuthor", fields: [authorId], references: [id])
  authorId    String?
  /// Snapshot of submitter contact in case the author user gets deleted.
  authorName  String
  authorEmail String?
  authorPhone String?

  handledBy   User?    @relation("ComplaintHandler", fields: [handledById], references: [id])
  handledById String?
  resolutionNote String? @db.Text
  resolvedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

// ============================================================
// LIBRARY (books for purchase request / rental)
// ============================================================

enum BookAvailability {
  AVAILABLE
  RENTED_OUT
  OUT_OF_STOCK
  ARCHIVED
}

model Book {
  id          String  @id @default(cuid())
  title       String
  author      String?
  isbn        String? @unique
  category    String?
  coverUrl    String?
  description String? @db.Text
  /// Total copies the school holds. Set to null for unlimited (digital).
  totalCopies Int     @default(1)
  /// How many are currently rented out. Computed via app logic; not enforced
  /// in DB to avoid race conditions on raw counts.
  copiesOut   Int     @default(0)
  /// Naira price for outright purchase (₦); null = rental-only.
  pricePurchase Decimal? @db.Decimal(10, 2)
  /// Naira rental price per term (₦); null = purchase-only.
  priceRental   Decimal? @db.Decimal(10, 2)
  availability  BookAvailability @default(AVAILABLE)

  requests BookRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, availability])
}

enum BookRequestType {
  PURCHASE
  RENTAL
}

enum BookRequestStatus {
  PENDING
  APPROVED
  REJECTED
  COLLECTED
  RETURNED
}

// ============================================================
// AWARDS / RECOGNITION
// ============================================================

enum AwardCategory {
  ACADEMIC_EXCELLENCE
  ATTENDANCE
  CONDUCT
  LEADERSHIP
  SPORTSMANSHIP
  COMMUNITY_SERVICE
  ARTS
  IMPROVEMENT
  PERFECT_ATTENDANCE
  OTHER
}

model Award {
  id        String @id @default(cuid())
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  term      Term?   @relation(fields: [termId], references: [id])
  termId    String?
  session   AcademicSession? @relation(fields: [sessionId], references: [id])
  sessionId String?

  category  AwardCategory
  title     String  // e.g. "Best Mathematics Student"
  citation  String? @db.Text
  /// 1-5 stars; surfaced on result slip + student profile.
  stars     Int     @default(5)
  awardedAt DateTime @default(now())
  /// User (admin/director/teacher) who issued the award.
  awardedById String?
  awardedBy   User?  @relation("AwardedBy", fields: [awardedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, termId])
  @@index([category])
}

model BookRequest {
  id        String  @id @default(cuid())
  book      Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId    String
  requester User    @relation("BookRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  requesterId String
  type      BookRequestType
  status    BookRequestStatus @default(PENDING)
  notes     String?  @db.Text
  /// For rentals — the due-back date set by admin on approval.
  dueDate   DateTime?

  decidedBy   User?   @relation("BookApprover", fields: [decidedById], references: [id])
  decidedById String?
  decidedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([requesterId])
}
